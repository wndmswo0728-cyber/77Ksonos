			
# (c) Silvaco Inc., 2015
assign name=xs n.value=1.0e-14 ratio=0.1


go atlas simflags="-160 -P 4"
TITLE planar device simulation
# SONOS P/E, one deck per temperature (only set temp differs between SONOS_PE_77K.in and SONOS_PE_300K.in).
# Changes vs the original SONOS_PRG_ERS.in and their reasons: CHANGES_KO.md
#
set Nsub=1e17
set Tbox=0.003
set Nnit=5e19
set Enit=1.2
set toxide=sio2  
#sio2,al2o3, hfo2
set cwf=4.05

set Ttox=0.008	
set Tnit=0.007
set Lgate=1
set vcgate=16
set ecgate=-12
set Tpg=0.08

set TPGM=1.0e-4
set TERS=5.0e-4
set Retime=3e8
set temp=300

set Ltotal=$Lgate*3
set Lgate_mid=$Ltotal/2
set Lgate_left=$Lgate_mid - $Lgate/2
set Lgate_right=$Lgate_mid + $Lgate/2

set Lsc = $Lgate_left*2/3		
set Ldc = $Ltotal - $Lsc
set Ls  = $Lgate_left - 0.005
set Ld  = $Lgate_right + 0.005

mesh   width = 1	

x.mesh loc=0.0   spac=$Lgate*0.25
x.mesh loc=@Lgate_left   spac=$Lgate*0.05
x.mesh loc=@Lgate_mid    spac=$Lgate*0.05
x.mesh loc=@Lgate_right  spac=$Lgate*0.05
x.mesh loc=@Ltotal   spac=$Lgate*0.25


y.mesh loc=-$Tpg-$Ttox-$Tnit-$Tbox        spac=0.1
y.mesh loc=-$Tpg*0.1-$Ttox-$Tnit-$Tbox    spac=$Ttox*2
y.mesh loc=-$Ttox-$Tnit-$Tbox             spac=$Ttox/10
y.mesh loc=-$Tnit-$Tbox                   spac=$Ttox/10
y.mesh loc=-$Tbox                         spac=$Tbox/10
y.mesh loc=0                              spac=$Tbox/100
y.mesh loc=0.01   spac=0.003
y.mesh loc=0.02   spac=0.005
y.mesh loc=0.05   spac=0.01
y.mesh loc=0.1    spac=0.1
y.mesh loc=0.4    spac=0.5

region number=1  y.min=-$Tpg-$Ttox-$Tnit-$Tbox  material=air
region number=2  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox material=conductor

#Oxide on the nitride
region number=3  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Ttox-$Tnit-$Tbox y.max=-$Tnit-$Tbox material=$toxide

#nitride
region number=4  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tnit-$Tbox y.max=-$Tbox material=nitride

#Oxide under the nitride
region number=5  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tbox y.max=0  material=oxide

#Substrate
region number=6  y.min=0   material=silicon


electrode name=cgate x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox
electrode name=source x.min=0.0 x.max=@Lsc y.min=0 y.max=0 
electrode name=drain  x.min=@Ldc x.max=@Ltotal y.min=0  y.max=0 
electrode name=substrate bottom

doping uniform conc=@Nsub p.type reg=6
doping uniform conc=1e21 n.type reg=2
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.r=@Ls
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.l=@Ld

interface n.i dynasonos

#top oxide
material material=$toxide semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60
#bottom oxide
material material=oxide semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60

material material=nitride semiconductor nc300=1e19 nv300=1e19 mun=1.0e-1 mup=1.0e-2 mc=1.0 mv=1.0 taun0=1.0 taup0=1.0 ni.min=1e-60

# MODELS with temperature= before CONTACT/METHOD (manual 2.5.2 order); in the original position 77 K was only partly applied
models srh temperature=@temp

contact name=cgate workf=$cwf		

nitridecharge nt.p=1.0e19 nt.n=@Nnit tau.n=1.0e-4 tau.p=1.0e-4 elec.depth=@Enit hole.depth=@Enit sigmat.n=$xs sigman.p=0.0 sigmap.n=0.0

method carriers=2

probe name=netcharge sonos.charge integrate x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tnit-$Tbox y.max=-$Tbox

######## init_ structure####
models srh temperature=@temp
solve init
output qfn qfp con.band val.band Band.param t.quantum
save outf=SONOS_initial_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str

solve prev
# drain in small steps (one 0.1 V step diverges at 77 K); read from 0 V
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1

log outf=SONOS_initial_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.log
solve vcgate=0 vstep=0.1 name=cgate vfinal=6
log off

#################### PROGRAM #######################

solve init
# full solution at 0 V before the Program transient
solve prev

# Charge up the Nitride region
models srh pf.nitride temperature=@temp
log outf=TRNS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.log
set vcgate_split=$vcgate/10
method dt.max=5e-12
solve vcgate=$vcgate_split ramptime=1e-10 tstep=1e-12 tfinal=1e-10
method dt.max=2e-11
solve vcgate=$vcgate ramptime=9e-10 tstep=2e-12 tfinal=1e-9
method dt.max=1e-3 dt.min=1e-25 cx.tol=1e-4
solve tstop=1.0e-8 proj
solve tstop=1.0e-7 proj
method dt.min=1.0e-8 cx.tol=1e-4
solve tstop=1e-6 proj
method dt.min=1.0e-7 cx.tol=1e-4
solve tstop=@TPGM proj
# pulse fall edge as a transient (SOLVE INIT after the pulse fails at 77 K with charged nitride): mirrored rise,
# then 1 us at 0 V; the state is saved at 0 V
method dt.max=2e-11 dt.min=1e-25
solve vcgate=$vcgate_split ramptime=9e-10 tstep=2e-12 tstop=9e-10 relative
method dt.max=5e-12 dt.min=1e-25
solve vcgate=0 ramptime=1e-10 tstep=1e-12 tstop=1e-10 relative
method dt.max=1e-3 dt.min=1e-25
solve tstop=1e-6 relative proj
log off


#################### Vt after PGM ################## 

output qfn qfp con.band val.band Band.param t.quantum
save outf=SONOS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str

#################### Vt after PGM (transient read) ####################
# static reads of charged states fail at 77 K; this read was checked against the static read on the fresh device
models srh ^pf.nitride temperature=@temp
load infile=SONOS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str master
solve prev
method dt.max=1e-9 dt.min=1e-25 cx.tol=1e-5
log outf=TREAD_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.log master
solve vdrain=0.1 ramptime=1e-8 tstep=1e-12 tstop=2e-8
solve vcgate=6.0 ramptime=6.0e-07 tstep=1e-12 tstop=6.20e-07
log off

#################### Erase #########################
# starts from the Program state saved at 0 V
models srh ^pf.nitride temperature=@temp
load infile=SONOS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str master
solve prev

#Charge out the Nitride region
# Absolute times as in the original deck: after LOAD the time starts again at 0 (seen in every run), but a RELATIVE
# TSTOP right after a LOAD used the end time of the previous transient in the same run (77fix read deck). RELATIVE is
# used only for the fall edge, which directly follows a transient.
models srh pf.nitride temperature=@temp
log outf=TRNS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.log
method dt.max=5e-12 dt.min=1e-25 cx.tol=1e-4
solve vcgate=$ecgate ramptime=1e-9 tstep=1e-12 tfinal=1e-9
method dt.max=1e-3 dt.min=1e-25 cx.tol=1e-4
solve tstop=1.0e-8 proj
solve tstop=1.0e-7 proj
method dt.min=1.0e-8 cx.tol=1e-4
solve tstop=1e-6 proj
method dt.min=1.0e-7 cx.tol=1e-4
solve tstop=1e-5 proj
method dt.min=1.0e-6 cx.tol=1e-4
solve tstop=@TERS proj
# pulse fall edge as a transient (SOLVE INIT after the pulse fails at 77 K with charged nitride): mirrored rise,
# then 1 us at 0 V; the state is saved at 0 V
set ecgate_fall=$ecgate/10
method dt.max=5e-12 dt.min=1e-25 cx.tol=1e-4
solve vcgate=$ecgate_fall ramptime=9e-10 tstep=2e-12 tstop=9e-10 relative
solve vcgate=0 ramptime=1e-10 tstep=1e-12 tstop=1e-10 relative
method dt.max=1e-3 dt.min=1e-25 cx.tol=1e-4
solve tstop=1e-6 relative proj
log off

#################### Vt after ERS #################
output qfn qfp con.band val.band Band.param t.quantum
save outf=SONOS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str

#################### Vt after ERS (transient read) ####################
# static reads of charged states fail at 77 K; this read was checked against the static read on the fresh device
models srh ^pf.nitride temperature=@temp
load infile=SONOS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.str master
solve prev
method dt.max=1e-9 dt.min=1e-25 cx.tol=1e-5
log outf=TREAD_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_$toxide|_cwf_$cwf|_temp_$temp|.log master
solve vdrain=0.1 ramptime=1e-8 tstep=1e-12 tstop=2e-8
solve vcgate=5.0 ramptime=5.0e-07 tstep=1e-12 tstop=5.20e-07
log off

quit
