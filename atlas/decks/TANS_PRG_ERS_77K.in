			
# (c) Silvaco Inc., 2015
assign name=xs n.value=1.0e-14 ratio=0.1


go atlas simflags="-160"
TITLE planar device simulation
#
set Nsub=1e17
set Tbox=0.001
set Nnit=5e19
set Enit=1.2
#set toxide=sio2  
#sio2,al2o3, hfo2
set cwf=4.5

set Ttox=0.008	
set Tnit=0.007
set Lgate=1
set vcgate=16
set ecgate=-12
set Tpg=0.08

set TPGM=1.0e-4
set TERS=5.0e-4
set Retime=3e8
set temp=77
set Vrd_lo=-2
set Vrd_hi=8
set Vrd_step=0.1
# read sweep: Vg from Vrd_lo to Vrd_hi in Vrd_step (V), VD=0.1 V, same for every state


set Ltotal=$Lgate*3
set Lgate_mid=$Ltotal/2
set Lgate_left=$Lgate_mid - $Lgate/2
set Lgate_right=$Lgate_mid + $Lgate/2

set Lsc = $Lgate_left*2/3		
set Ldc = $Ltotal - $Lsc
set Ls  = $Lgate_left - 0.005
set Ld  = $Lgate_right + 0.005

mesh   width = 1	

x.mesh loc=0.0   spac=$Lgate*0.25
x.mesh loc=@Lgate_left   spac=$Lgate*0.05
x.mesh loc=@Lgate_mid    spac=$Lgate*0.05
x.mesh loc=@Lgate_right  spac=$Lgate*0.05
x.mesh loc=@Ltotal   spac=$Lgate*0.25


y.mesh loc=-$Tpg-$Ttox-$Tnit-$Tbox        spac=0.1
y.mesh loc=-$Tpg*0.1-$Ttox-$Tnit-$Tbox    spac=$Ttox*2
y.mesh loc=-$Ttox-$Tnit-$Tbox             spac=$Ttox/10
y.mesh loc=-$Tnit-$Tbox                   spac=$Ttox/10
y.mesh loc=-$Tbox                         spac=$Tbox/10
y.mesh loc=0                              spac=$Tbox/100
y.mesh loc=0.01   spac=0.003
y.mesh loc=0.02   spac=0.005
y.mesh loc=0.05   spac=0.01
y.mesh loc=0.1    spac=0.1
y.mesh loc=0.4    spac=0.5

region number=1  y.min=-$Tpg-$Ttox-$Tnit-$Tbox  material=air
region number=2  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox material=TaN

#Oxide on the nitride
region number=3  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Ttox-$Tnit-$Tbox y.max=-$Tnit-$Tbox material=Al2O3

#nitride
region number=4  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tnit-$Tbox y.max=-$Tbox material=nitride

#Oxide under the nitride
region number=5  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tbox y.max=0  material=Sio2

#Substrate
region number=6  y.min=0   material=silicon


electrode name=cgate x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox
electrode name=source x.min=0.0 x.max=@Lsc y.min=0 y.max=0 
electrode name=drain  x.min=@Ldc x.max=@Ltotal y.min=0  y.max=0 
electrode name=substrate bottom

doping uniform conc=@Nsub p.type reg=6
#doping uniform conc=1e21 n.type reg=2
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.r=@Ls
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.l=@Ld

interface n.i dynasonos

#top oxide
material material=Al2O3 semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60
#bottom oxide
material material=SiO2 semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60
material material=nitride semiconductor nc300=1e19 nv300=1e19 mun=1.0e-1 mup=1.0e-2 mc=1.0 mv=1.0 taun0=1.0 taup0=1.0 ni.min=1e-60
contact name=cgate workf=$cwf		

nitridecharge nt.p=1.0e19 nt.n=@Nnit tau.n=1.0e-4 tau.p=1.0e-4 elec.depth=@Enit hole.depth=@Enit sigmat.n=$xs sigman.p=0.0 sigmap.n=0.0

models srh pf.nitride temperature=@temp
models region=6 fermidirac incomplete ioniz cvt bbt.kl trap.tunnel
method carriers=2

probe name=netcharge sonos.charge integrate x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tnit-$Tbox y.max=-$Tbox

######## init_ structure####
solve init
output qfn qfp con.band val.band Band.param t.quantum
save outf=T77K_PE_TANS_initial_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.str

solve prev
solve vcgate=0 vstep=-0.1 name=cgate vfinal=$Vrd_lo
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1

log outf=T77K_PE_TANS_initial_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.log
solve vcgate=$Vrd_lo vstep=$Vrd_step name=cgate vfinal=$Vrd_hi
extract name="Vt_init" xintercept(maxslope(curve(v."cgate",i."drain"))) datafile="T77K_TANS_PE_Vt.dat"
extract name="Vt_init_vd2" xintercept(maxslope(curve(v."cgate",i."drain"))) - ave(v."drain")/2 datafile="T77K_TANS_PE_Vt.dat"
extract name="IdVg_init" curve(v."cgate",i."drain") outfile="T77K_TANS_PE_init_IdVg.dat"
log off

#################### PROGRAM #######################

solve name=drain vstep=-0.02 vfinal=0
solve name=cgate vstep=-0.2 vfinal=0

# Charge up the Nitride region
log outf=T77K_PE_TRNS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.log
set vcgate_split=$vcgate/10
method dt.max=5e-12
solve vcgate=$vcgate_split ramptime=1e-10 tstep=1e-12 tfinal=1e-10
solve vcgate=$vcgate ramptime=9e-10 tstep=2e-12 tfinal=1e-9
method dt.max=1e-3 dt.min=1.0e-9
solve tstop=1.0e-8 proj
solve tstop=1.0e-7 proj
method dt.min=1.0e-8
solve tstop=1e-6 proj
method dt.min=1.0e-7
solve tstop=@TPGM proj
log off


#################### Vt after PGM ################## 

output qfn qfp con.band val.band Band.param t.quantum
save outf=T77K_PE_TANS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.str

solve name=cgate vstep=-0.5 vfinal=0

solve vcgate=0 vstep=-0.1 name=cgate vfinal=$Vrd_lo
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1

log outf=T77K_PE_TANS_PGM_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.log master
solve vcgate=$Vrd_lo vstep=$Vrd_step name=cgate vfinal=$Vrd_hi
extract name="Vt_PGM" xintercept(maxslope(curve(v."cgate",i."drain"))) datafile="T77K_TANS_PE_Vt.dat"
extract name="Vt_PGM_vd2" xintercept(maxslope(curve(v."cgate",i."drain"))) - ave(v."drain")/2 datafile="T77K_TANS_PE_Vt.dat"
extract name="IdVg_PGM" curve(v."cgate",i."drain") outfile="T77K_TANS_PE_PGM_IdVg.dat"
log off

#################### Erase #########################
solve name=drain vstep=-0.02 vfinal=0
solve name=cgate vstep=-0.2 vfinal=0

# Reset transient controls BEFORE starting erase
method dt.min=1.0e-15 itlimit=50

#Charge out the Nitride region
log outf=T77K_PE_TRNS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.log
set ecgate_split=$ecgate/10
method dt.max=5e-12
solve vcgate=$ecgate_split ramptime=1e-10 tstep=1e-12 tfinal=1e-10
solve vcgate=$ecgate ramptime=9e-10 tstep=2e-12 tfinal=1e-9
method dt.max=1e-3 dt.min=1.0e-9
solve tstop=1.0e-8 proj
solve tstop=1.0e-7 proj
method dt.min=1.0e-8
solve tstop=1e-6 proj
method dt.min=1.0e-7
solve tstop=1e-5 proj
method dt.min=1.0e-6
solve tstop=@TERS proj
log off

#################### Vt after ERS #################
output qfn qfp con.band val.band Band.param t.quantum
save outf=T77K_PE_TANS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.str

solve name=cgate vstep=0.5 vfinal=0

solve vcgate=0 vstep=-0.1 name=cgate vfinal=$Vrd_lo
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1

log outf=T77K_PE_TANS_ERS_nt_$Nnit|_Et_$Enit|_Tbox_$Tbox|_Nsub_$Nsub|_toxide_Al2O3|_cwf_$cwf|.log master
solve vcgate=$Vrd_lo vstep=$Vrd_step name=cgate vfinal=$Vrd_hi
extract name="Vt_ERS" xintercept(maxslope(curve(v."cgate",i."drain"))) datafile="T77K_TANS_PE_Vt.dat"
extract name="Vt_ERS_vd2" xintercept(maxslope(curve(v."cgate",i."drain"))) - ave(v."drain")/2 datafile="T77K_TANS_PE_Vt.dat"
extract name="IdVg_ERS" curve(v."cgate",i."drain") outfile="T77K_TANS_PE_ERS_IdVg.dat"
log off

################ ERS retention (added) ################
solve name=drain vstep=-0.02 vfinal=0
solve name=cgate vstep=-0.2 vfinal=0
method lte2step tol.time=1.0e-4 tstep.incr=1.2 dt.max=1.0e7
log outfile=T77K_PE_TRNS_ERS_Retention.log sonos.curr j.tun
solve tstep=1e-6 tfinal=@Retime proj
extract name="Qnit_ERS_vs_t" curve(time, probe."netcharge") outfile="T77K_TANS_ERS_netcharge_vs_time.dat"
save outf=T77K_PE_TANS_ERS_RETEN.str
log off

################ Vt after ERS retention ################
solve init sonos
solve prev
solve vcgate=0 vstep=-0.1 name=cgate vfinal=$Vrd_lo
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1

log outf=T77K_PE_TANS_ERS_RETEN.log master
solve vcgate=$Vrd_lo vstep=$Vrd_step name=cgate vfinal=$Vrd_hi
extract name="Vt_ERSRET" xintercept(maxslope(curve(v."cgate",i."drain"))) datafile="T77K_TANS_PE_Vt.dat"
extract name="Vt_ERSRET_vd2" xintercept(maxslope(curve(v."cgate",i."drain"))) - ave(v."drain")/2 datafile="T77K_TANS_PE_Vt.dat"
extract name="IdVg_ERSRET" curve(v."cgate",i."drain") outfile="T77K_TANS_PE_ERSRET_IdVg.dat"
log off
quit
