			
# (c) Silvaco Inc., 2015
assign name=xs n.value=1.0e-14 ratio=0.1


# DIAG B6a (77 K, self-contained). B5a and B5b saved IDENTICAL states after the injection, but
# their PGM reads differed (B5a channel off up to 8 V, B5b stopped at 4.6 V), so the cause is in
# the read. Same 66-step injection, then the read up to Vg = 4 V only, saving .str at Vg = 0, 2,
# 3, 4 V (VD = 0.1 V) to compare the free electrons in the nitride. Case: pf.nitride on from the start (= B5a, the invalid 2nd run: channel stayed off).
go atlas simflags="-160"
TITLE planar device simulation
#
set Nsub=1e17
set Tbox=0.003
set Nnit=5e19
set Enit=1.2
set toxide=sio2  
#sio2,al2o3, hfo2
set cwf=4.05

set Ttox=0.008	
set Tnit=0.007
set Lgate=1
set vcgate=16
set ecgate=-12
set Tpg=0.08

set TPGM=1.0e-4
set TERS=5.0e-4
set Retime=3e8
set temp=77
set Vrd_lo=-2
set Vrd_hi=8
set Vrd_step=0.1
# read sweep: Vg from Vrd_lo to Vrd_hi in Vrd_step (V), VD=0.1 V, same for every state


set Ltotal=$Lgate*3
set Lgate_mid=$Ltotal/2
set Lgate_left=$Lgate_mid - $Lgate/2
set Lgate_right=$Lgate_mid + $Lgate/2

set Lsc = $Lgate_left*2/3		
set Ldc = $Ltotal - $Lsc
set Ls  = $Lgate_left - 0.005
set Ld  = $Lgate_right + 0.005

mesh   width = 1	

x.mesh loc=0.0   spac=$Lgate*0.25
x.mesh loc=@Lgate_left   spac=$Lgate*0.05
x.mesh loc=@Lgate_mid    spac=$Lgate*0.05
x.mesh loc=@Lgate_right  spac=$Lgate*0.05
x.mesh loc=@Ltotal   spac=$Lgate*0.25


y.mesh loc=-0.1                         spac=0.1
y.mesh loc=-0.1+$Tpg                    spac=0.01
y.mesh loc=-0.1+$Tpg+$Ttox              spac=$Ttox/6
y.mesh loc=-0.1+$Tpg+$Ttox+$Tnit        spac=$Tnit*0.15
y.mesh loc=-0.1+$Tpg+$Ttox+$Tnit+$Tbox  spac=$Tbox/6
y.mesh loc=0.01   spac=0.003
y.mesh loc=0.02   spac=0.005
y.mesh loc=0.05   spac=0.01
y.mesh loc=0.1    spac=0.1
y.mesh loc=0.4    spac=0.5

region number=1  y.min=-0.1   material=air
region number=2  x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1 y.max=-0.1+$Tpg material=conductor

#Oxide on the nitride
region number=3  x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1+$Tpg y.max=-0.1+$Tpg+$Ttox material=$toxide

#hafnium
region number=4  x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1+$Tpg+$Ttox y.max=-0.1+$Tpg+$Ttox+$Tnit material=nitride

#Oxide under the nitride
region number=5  x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1+$Tpg+$Ttox+$Tnit y.max=-0.1+$Tpg+$Ttox+$Tnit+$Tbox  material=oxide

#Substrate
region number=6  y.min=-0.1+$Tpg+$Ttox+$Tnit+$Tbox   material=silicon


electrode name=cgate x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1 y.max=-0.1+$Tpg
electrode name=source x.min=0.0 x.max=@Lsc y.min=-0.1+$Tpg+$Ttox+$Tnit+$Tbox  y.max=-0.1+$Tpg+$Ttox+$Tnit+$Tbox 
electrode name=drain  x.min=@Ldc x.max=@Ltotal y.min=-0.1+$Tpg+$Ttox+$Tnit+$Tbox  y.max=-0.1+$Tpg+$Ttox+$Tnit+$Tbox 
electrode name=substrate bottom

doping uniform conc=@Nsub p.type reg=6
doping uniform conc=1e21 n.type reg=2
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.r=@Ls
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.l=@Ld

interface n.i dynasonos


#top oxide
material material=$toxide semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60
#bottom oxide
material material=oxide semiconductor taun0=1.0 taup0=1.0 mc=0.3 mv=1.0 nc300=1e19 nv300=1e19 ni.min=1e-60
material material=nitride semiconductor nc300=1e19 nv300=1e19 mun=1.0e-1 mup=1.0e-2 mc=1.0 mv=1.0 taun0=1.0 taup0=1.0 ni.min=1e-60
contact name=cgate workf=$cwf				

nitridecharge nt.p=0.0e19 nt.n=@Nnit tau.n=1.0e-4 tau.p=1.0e-4 elec.depth=@Enit hole.depth=@Enit sigmat.n=${xs} sigman.p=0.0 sigmap.n=0.0

models srh pf.nitride temperature=@temp
models region=6 fermidirac incomplete ioniz cvt bbt.kl trap.tunnel
method carriers=2

probe name=netcharge sonos.charge integrate x.min=@Lgate_left x.max=@Lgate_right y.min=-0.1+$Tpg+$Ttox y.max=-0.1+$Tpg+$Ttox+$Tnit

######################## init_ structure ######################
output qfn qfp con.band val.band
solve init
solve prev
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=$Tpg+$Ttox-0.1 nit.ymax=$Tpg+$Ttox+$Tnit-0.1 nit.n=1e17
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=$Tpg+$Ttox-0.1 nit.ymax=$Tpg+$Ttox+$Tnit-0.1 nit.n=2.5e17
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=$Tpg+$Ttox-0.1 nit.ymax=$Tpg+$Ttox+$Tnit-0.1 nit.n=5e17
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=$Tpg+$Ttox-0.1 nit.ymax=$Tpg+$Ttox+$Tnit-0.1 nit.n=7.5e17
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=$Tpg+$Ttox-0.1 nit.ymax=$Tpg+$Ttox+$Tnit-0.1 nit.n=1e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=1.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=1.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=1.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=2e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=2.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=2.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=2.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=3e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=3.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=3.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=3.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=3.875e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.125e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.375e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.625e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=4.875e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.125e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.375e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.625e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=5.875e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.125e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.25e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.375e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.5e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.625e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=6.875e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=7e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=7.125e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=7.25e18
