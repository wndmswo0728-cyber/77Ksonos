solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=8.75e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=8.875e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=9e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=9.125e18
solve nit.xmin=@Lgate_left nit.xmax=@Lgate_right nit.ymin=-0.1+$Tpg+$Ttox nit.ymax=-0.1+$Tpg+$Ttox+$Tnit nit.n=9.25e18
