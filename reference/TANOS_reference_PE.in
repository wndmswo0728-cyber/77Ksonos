# TANOS_reference_PE. Reference geometry, uncalibrated parameters.
go atlas
title TANOS_reference_PE
mesh width=1
x.mesh loc=0 spac=0.15
x.mesh loc=0.995 spac=0.005
x.mesh loc=1 spac=0.005
x.mesh loc=1.5 spac=0.05
x.mesh loc=2 spac=0.005
x.mesh loc=2.005 spac=0.005
x.mesh loc=3 spac=0.15
y.mesh loc=-0.098000 spac=0.02
y.mesh loc=-0.018000 spac=0.0005
y.mesh loc=-0.010000 spac=0.0004
y.mesh loc=-0.003000 spac=0.0002
y.mesh loc=0.000000 spac=0.00015
y.mesh loc=0.010000 spac=0.002
y.mesh loc=0.030000 spac=0.004
y.mesh loc=0.100000 spac=0.012
y.mesh loc=0.400000 spac=0.05
region num=1 material=air
region num=2 material=conductor x.min=1 x.max=2 y.min=-0.098000 y.max=-0.018000
region num=3 material=Al2O3 x.min=1 x.max=2 y.min=-0.018000 y.max=-0.010000
region num=4 material=nitride x.min=1 x.max=2 y.min=-0.010000 y.max=-0.003000
region num=5 material=oxide x.min=1 x.max=2 y.min=-0.003 y.max=0
region num=6 material=silicon y.min=0
electrode name=cgate x.min=1 x.max=2 y.min=-0.098000 y.max=-0.018000
electrode name=source x.min=0 x.max=0.666667 y.min=0 y.max=0
electrode name=drain x.min=2.333333 x.max=3 y.min=0 y.max=0
electrode name=substrate bottom
doping uniform p.type conc=1e17 reg=6
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.r=0.995
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.l=2.005
interface n.i dynasonos
material material=Al2O3 eg300=8 egalpha=0 affinity=1.50 permittivity=9.3 semiconductor nc300=1e19 nv300=1e19 mc=0.3 mv=1 mun=0.1 mup=0.01 taun0=1 taup0=1
material material=oxide eg300=9 egalpha=0 affinity=0.95 permittivity=3.9 semiconductor nc300=1e19 nv300=1e19 mc=0.3 mv=1 mun=0.1 mup=0.01 taun0=1 taup0=1
material material=nitride semiconductor eg300=5.1 egalpha=0 affinity=2.05 permittivity=7.5 nc300=1e19 nv300=1e19 mc=1 mv=1 mun=0.1 mup=0.01 taun0=1 taup0=1
# e/h depths and cross-sections are starting assumptions, not fitted data.
nitridecharge nt.n=1e19 nt.p=1e19 elec.depth=1.2 hole.depth=1.2 sigmat.n=1e-14 sigmat.p=1e-14 sigman.p=1e-16 sigmap.n=1e-16 pf.b=1e13
contact name=cgate workf=4.60
models srh temp=77 print pf.nitride
models region=6 fermidirac incomplete ioniz analytic bbt.kl print
method newton carriers=2 dt.min=1e-14
probe name=bbt_drain r.bbt x=2.005 y=0.001
probe name=netcharge sonos.charge integrate x.min=1 x.max=2 y.min=-0.010000 y.max=-0.003000
output con.band val.band qfn qfp sonos.rates u.bbt e.field band.param
solve init
log outf=TANOS_reference_PE_pgm.log sonos.curr
solve vcgate=16 ramptime=1E-9 tstep=1E-11 tstop=0.000000001
solve tstop=0.00000001
solve tstop=0.0000001
solve tstop=0.000001
solve tstop=0.00001
solve tstop=0.0001
solve vcgate=0 ramptime=1E-9 tstep=1E-11 tstop=0.000100001
log off
save outf=TANOS_reference_PE_pgm_zero.str
log outf=TANOS_reference_PE_ers.log sonos.curr
solve vcgate=-12 ramptime=1E-9 tstep=1E-11 tstop=0.000100002
solve tstop=0.000100011
solve tstop=0.000100101
solve tstop=0.000101001
solve tstop=0.000110001
solve tstop=0.000600001
solve vcgate=0 ramptime=1E-9 tstep=1E-11 tstop=0.000600002
log off
save outf=TANOS_reference_PE_ers_zero.str
quit
