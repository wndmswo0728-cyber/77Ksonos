# TANS 300K PF_on_Hopping_on ALL_IV.in (build copy)
# Source: ChargeTrap_77K_Ready_To_Run.zip. Procedure-only changes, see README_KO.md:
#  (1) models moved before contact, (2) drain stepped 1e-4 -> 1e-3 -> 0.01 -> 0.1 V,
#  (3) Vt extract added after each read. ox.charge, models, mesh unchanged.
go atlas simflags="-V 5.36.0.R -160"
set Nsub=1e17
set Tbox=0.001
set Nnit=5e19
set Enit=1.2
set cwf=4.5
set Ttox=0.008
set Tnit=0.007
set Lgate=1
set vcgate=16
set ecgate=-12
set Tpg=0.08
set TPGM=1.0e-4
set TERS=5.0e-4
set Retime=3e8
set Ltotal=$Lgate*3
set Lgate_mid=$Ltotal/2
set Lgate_left=$Lgate_mid - $Lgate/2
set Lgate_right=$Lgate_mid + $Lgate/2
set Lsc = $Lgate_left*2/3
set Ldc = $Ltotal - $Lsc
set Ls  = $Lgate_left - 0.005
set Ld  = $Lgate_right + 0.005
mesh   width = 1
x.mesh loc=0.0   spac=$Lgate*0.25
x.mesh loc=@Ls spac=0.005
x.mesh loc=@Lgate_left   spac=0.005
x.mesh loc=@Lgate_mid    spac=$Lgate*0.05
x.mesh loc=@Lgate_right  spac=0.005
x.mesh loc=@Ld spac=0.005
x.mesh loc=@Ltotal   spac=$Lgate*0.25
y.mesh loc=-$Tpg-$Ttox-$Tnit-$Tbox        spac=0.1
y.mesh loc=-$Tpg*0.1-$Ttox-$Tnit-$Tbox    spac=$Ttox*2
y.mesh loc=-$Ttox-$Tnit-$Tbox             spac=$Ttox/10
y.mesh loc=-$Tnit-$Tbox                   spac=$Ttox/10
y.mesh loc=-0.006250000 spac=0.00035
y.mesh loc=-0.004500000 spac=0.00035
y.mesh loc=-0.002750000 spac=0.00035
y.mesh loc=-$Tbox                         spac=$Tbox/10
y.mesh loc=0                              spac=$Tbox/100
y.mesh loc=0.01   spac=0.003
y.mesh loc=0.02   spac=0.005
y.mesh loc=0.05   spac=0.01
y.mesh loc=0.1    spac=0.1
y.mesh loc=0.4    spac=0.5
region number=1  y.min=-$Tpg-$Ttox-$Tnit-$Tbox  material=air
region number=2  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox material=TaN
region number=3  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Ttox-$Tnit-$Tbox y.max=-$Tnit-$Tbox material=Al2O3
region number=4 material=nitride x.min=@Lgate_left x.max=@Lgate_right y.min=-0.002750000 y.max=-0.001000000
region number=5  x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tbox y.max=0  material=Sio2
region number=6  y.min=0   material=silicon
region number=7 material=nitride x.min=@Lgate_left x.max=@Lgate_right y.min=-0.004500000 y.max=-0.002750000
region number=8 material=nitride x.min=@Lgate_left x.max=@Lgate_right y.min=-0.006250000 y.max=-0.004500000
region number=9 material=nitride x.min=@Lgate_left x.max=@Lgate_right y.min=-0.008000000 y.max=-0.006250000
electrode name=cgate x.min=@Lgate_left x.max=@Lgate_right y.min=-$Tpg-$Ttox-$Tnit-$Tbox y.max=-$Ttox-$Tnit-$Tbox
electrode name=source x.min=0.0 x.max=@Lsc y.min=0 y.max=0
electrode name=drain  x.min=@Ldc x.max=@Ltotal y.min=0  y.max=0
electrode name=substrate bottom
doping uniform conc=@Nsub p.type reg=6
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.r=@Ls
doping gauss n.type conc=5e20 char=0.03 lat.char=0.005 reg=6 x.l=@Ld

material material=nitride permittivity=7.5
material material=SiO2 permittivity=3.9
material material=Al2O3 permittivity=9.3
models srh fermidirac analytic incomplete bbt.kl temperature=300 print
contact name=cgate workf=$cwf
method newton carriers=2 itlimit=50
output con.band val.band qfn qfp e.field ox.charge
solve init
save outf=INITIAL.str
solve vdrain=0.0001
solve vdrain=0.001
solve name=drain vstep=0.001 vfinal=0.01
solve name=drain vstep=0.005 vfinal=0.1
solve vcgate=0 vstep=-0.05 name=cgate vfinal=-2
log outf=INITIAL_IV.log master
solve previous
solve name=cgate vstep=0.05 vfinal=11
log off
extract init infile="INITIAL_IV.log"
extract name="Vt_gm_INITIAL" xintercept(maxslope(curve(v."cgate",i."drain"))) - ave(v."drain")/2 datafile="Vt_summary.dat"
extract name="Vt_cc_INITIAL" x.val from curve(v."cgate",i."drain") where y.val=1e-7 datafile="Vt_summary.dat"
extract name="IdVg_INITIAL" curve(v."cgate",i."drain") outfile="INITIAL_IdVg.dat"

