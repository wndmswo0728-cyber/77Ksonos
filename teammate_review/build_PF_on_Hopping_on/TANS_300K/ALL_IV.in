doping uniform region=4 ox.charge conc=-6.582955939964e+18
doping uniform region=7 ox.charge conc=-2.786260864921e+18
doping uniform region=8 ox.charge conc=-1.167698625435e+18
doping uniform region=9 ox.charge conc=-4.882895506827e+17
material material=nitride permittivity=7.5
material material=SiO2 permittivity=3.9
